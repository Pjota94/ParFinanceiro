# JWT: obrigatório em produção. Gere com: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_segura_aqui

# Turso (produção). Em desenvolvimento, deixe em branco para usar arquivo local em frontend/data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Depois de criar a conta do casal em produção, defina como false para travar novos cadastros
ALLOW_REGISTRATION=true
